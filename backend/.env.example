# Azztec_SaaS_dotenv_example_v1_1_0.txt  →  backend/.env.example  (copy to backend/.env and fill the blanks)
# Version 1.1.0 · 2026-09-19 · Adriaan · never commit .env
# Changelog: 1.1.0 WORKMATE_DIAG_PERSIST / WORKMATE_DIAG_PURGE and the Azzmax dev actor (D1a, OD-56/57/60).
#            1.0.1 WORKMATE_LOG_LEVEL (S1d). 1.0.0 initial.
#
# get_settings() is lru_cached — a watchfiles reload does NOT pick up changes here. Restart the server.
# PowerShell heredocs have silently failed to write this file before; verify with Select-String.
WORKMATE_ENV=dev
WORKMATE_TZ=Pacific/Auckland
WORKMATE_LOG_LEVEL=INFO
# diagnostics: persist writes [F]/[G]/[E] rows to dbo.Diag_Log; purge runs the nightly delete.
# Set WORKMATE_DIAG_PURGE=false on every process but one when more than one worker runs.
WORKMATE_DIAG_PERSIST=true
WORKMATE_DIAG_PURGE=true
WORKMATE_SECRET_KEY=change-me-to-a-long-random-string
WORKMATE_FRONTEND_DIST=../web/dist

# --- database: SQL Server (dev — the RST data) ---
WORKMATE_DB_KIND=mssql
WORKMATE_DB_SERVER=localhost
WORKMATE_DB_NAME=dbWorkmate
WORKMATE_DB_USER=svc_workmate
WORKMATE_DB_PASSWORD=
WORKMATE_DB_TRUST_CERT=true
WORKMATE_DB_DRIVER=ODBC Driver 18 for SQL Server

# --- database: PostgreSQL (target) — switch KIND and set the URL ---
# WORKMATE_DB_KIND=postgresql
# WORKMATE_DB_URL=postgresql+psycopg://workmate:workmate@localhost:5432/workmate

WORKMATE_SQLALCHEMY_ECHO=false
# 21 = 'Azzmax logon' (AZZ) on RST — Andrew's administrator login, the agreed test identity (OD-56).
# Everything written while testing is stamped with it, which is the point: the trail shows who fixed what.
# 1 = SYS_USER stays the fallback on any install where no test login has been agreed.
WORKMATE_DEV_USER_ID=21
