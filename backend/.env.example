# Azztec_SaaS_dotenv_example_v1_2_0.txt  →  backend/.env.example  (copy to backend/.env and fill the blanks)
# Version 1.2.0 · 2026-11-06 · Adriaan · never commit .env
# Changelog: 1.2.0 sign-in: WORKMATE_SESSION_* / WORKMATE_COOKIE_SECURE / WORKMATE_LOCKOUT_* /
#            WORKMATE_RIGHTS_CACHE_SECONDS, all at the DP2 spec defaults (OD-97, OD-99, OD-100);
#            WORKMATE_DEV_USER_ID is no longer an identity for any request (OD-103).
#            1.1.0 WORKMATE_DIAG_PERSIST / WORKMATE_DIAG_PURGE and the Azzmax dev actor (D1a, OD-56/57/60).
#            1.0.1 WORKMATE_LOG_LEVEL (S1d). 1.0.0 initial.
#
# get_settings() is lru_cached — a watchfiles reload does NOT pick up changes here. Restart the server.
# PowerShell heredocs have silently failed to write this file before; verify with Select-String.
WORKMATE_ENV=dev
WORKMATE_TZ=Pacific/Auckland
WORKMATE_LOG_LEVEL=INFO
# diagnostics: persist writes [F]/[G]/[E] rows to dbo.Diag_Log; purge runs the nightly delete.
# Set WORKMATE_DIAG_PURGE=false on every process but one when more than one worker runs.
WORKMATE_DIAG_PERSIST=true
WORKMATE_DIAG_PURGE=true
WORKMATE_SECRET_KEY=change-me-to-a-long-random-string
WORKMATE_FRONTEND_DIST=../web/dist

# --- database: SQL Server (dev — the RST data) ---
WORKMATE_DB_KIND=mssql
WORKMATE_DB_SERVER=localhost
WORKMATE_DB_NAME=dbWorkmate
WORKMATE_DB_USER=svc_workmate
WORKMATE_DB_PASSWORD=
WORKMATE_DB_TRUST_CERT=true
WORKMATE_DB_DRIVER=ODBC Driver 18 for SQL Server

# --- database: PostgreSQL (target) — switch KIND and set the URL ---
# WORKMATE_DB_KIND=postgresql
# WORKMATE_DB_URL=postgresql+psycopg://workmate:workmate@localhost:5432/workmate

WORKMATE_SQLALCHEMY_ECHO=false

# --- sign-in (DP2) — people sign in with their Workmate.NET login and password ---
# The session cookie is HttpOnly + SameSite=Strict, and Secure while COOKIE_SECURE is true. Browsers accept
# a Secure cookie on http://localhost; a server reached by name or IP over plain http needs HTTPS, or the
# browser drops the cookie and nobody stays signed in. Leave it true; the deploy kit (DP4) brings HTTPS.
WORKMATE_SESSION_COOKIE=azztec_session
WORKMATE_SESSION_HOURS=12
WORKMATE_SESSION_IDLE_MINUTES=240
WORKMATE_COOKIE_SECURE=true
# lockout: this many failures for one login, or from one address, inside the window -> 423 until it passes
WORKMATE_LOCKOUT_FAILURES=5
WORKMATE_LOCKOUT_IP_FAILURES=20
WORKMATE_LOCKOUT_MINUTES=15
# a rights change in Workmate.NET bites within this many seconds; deactivating a user bites at once
WORKMATE_RIGHTS_CACHE_SECONDS=60

# No longer an identity for any request (OD-103): every request is the person signed in.
# Kept for scripts that want a default user id; 21 = 'Azzmax logon' (AZZ) on RST.
WORKMATE_DEV_USER_ID=21
